    "%sql\n",
    "USE instagram.goldlayer;\n",
    "\n",
    "CREATE OR REPLACE VIEW vw_security_behavior_analysis AS\n",
    "SELECT \n",
    "    u.age,\n",
    "    u.gender,\n",
    "    u.country,\n",
    "    s.*\n",
    "FROM dim_users u\n",
    "JOIN dim_security s ON u.user_id = s.user_id;"
