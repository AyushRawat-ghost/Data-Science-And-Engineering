   "source": [
    "use instagram.goldlayer;\n",
    "\n",
    "CREATE OR REPLACE VIEW vw_executive_engagement AS\n",
    "SELECT \n",
    "    e.*,\n",
    "    u.age, u.gender, u.country, u.income_level, u.employment_status,u.education_level,u.income_level\n",
    "FROM fact_user_engagement e\n",
    "JOIN dim_users u ON e.user_id = u.user_id;"
   ]
  }
