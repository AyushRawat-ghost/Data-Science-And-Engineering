   "source": [
    "CREATE OR REPLACE VIEW instagram.goldlayer.vw_security_subscription_stats AS\n",
    "SELECT \n",
    "    e.account_creation_year,\n",
    "    sec.*\n",
    "FROM instagram.goldlayer.dim_users e\n",
    "JOIN instagram.goldlayer.dim_security sec ON e.user_id = sec.user_id;"
   ]
  }
